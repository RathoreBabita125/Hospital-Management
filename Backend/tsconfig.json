{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions":true,
    "rewriteRelativeImportExtensions":true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}